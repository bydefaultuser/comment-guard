# Copy this file to .env and fill in what you have.

# ---- Layer 3: an LLM on Amazon Bedrock via boto3 (optional) ----
# The LLM check stays off until BEDROCK_MODEL_ID and ONE credential option below are filled in.
AWS_REGION=us-east-1
# Any text model your Bedrock account has access to - copy the model ID (or inference profile ID)
# from the Bedrock console. List them with:  aws bedrock list-foundation-models --region us-east-1
BEDROCK_MODEL_ID=

# Option A: AWS access keys (AWS_SESSION_TOKEN only for temporary credentials)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Option B: a named profile from ~/.aws/credentials
AWS_PROFILE=

# Option C: a Bedrock API key
AWS_BEARER_TOKEN_BEDROCK=

# ---- Layer 2: BERT models ----
# Set to true to run the models on the CPU even when a GPU is available.
FORCE_CPU=false
# Without the LLM: a comment is abusive when an abuse score (insult, threat, identity hate, severe toxic)
# reaches this value (0-1).
TOXICITY_THRESHOLD=0.5
# With the LLM: the toxicity model overrules an LLM "not abusive" answer only above this abuse score.
ABUSE_OVERRIDE_THRESHOLD=0.7
# A comment is flagged as negative feedback when the negative-sentiment score reaches this value (0-1).
NEGATIVE_THRESHOLD=0.6
